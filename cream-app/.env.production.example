# =============================================================================
# PRODUCTION .env TEMPLATE  (Hostinger)
# -----------------------------------------------------------------------------
# Copy this to `.env` INSIDE ~/cream-app on the server, fill in the real values,
# then run `php artisan key:generate` once and `php artisan config:cache`.
# NEVER commit the filled-in .env. See DEPLOY.md for the full runbook.
# =============================================================================

APP_NAME="Credence Real Estate"
APP_ENV=production
APP_KEY=                       # generate ONCE on the server: php artisan key:generate
APP_DEBUG=false                # must be false in production
APP_URL=https://credencerealestateandassetmgt.com   # the live canonical origin (https)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily                # rotate logs in production
LOG_LEVEL=error                # error+ only; avoid leaking debug detail

# --- Database (create the DB + user in hPanel first) -------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=                   # e.g. u530030175_cream
DB_USERNAME=                   # e.g. u530030175_cream
DB_PASSWORD=                   # strong, unique

# --- Sessions / cache / queue (all DB-backed; no Redis on this plan) ---------
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true     # HTTPS-only cookies in production
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Web-served uploads (SPLIT LAYOUT) ---------------------------------------
# The app lives outside public_html, so point the uploads disk at the REAL
# document-root uploads folder. Use the absolute server path.
UPLOADS_ROOT=/home/<user>/public_html/uploads
UPLOADS_URL=/uploads

# --- Mail: authenticated SMTP from a mailbox on our own domain ---------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465                  # 465 (SSL) or 587 (TLS)
MAIL_USERNAME=                 # e.g. noreply@credencerealestateandassetmgt.com
MAIL_PASSWORD=                 # mailbox password
MAIL_FROM_ADDRESS="noreply@credencerealestateandassetmgt.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where enquiry notifications + moderation digests go (falls back to info@ if blank).
MODERATION_EMAIL=info@credencerealestateandassetmgt.com

# --- Cloudflare Turnstile (REAL keys — the test keys always pass) ------------
TURNSTILE_SITEKEY=             # from the Cloudflare Turnstile dashboard
TURNSTILE_SECRET=              # from the Cloudflare Turnstile dashboard
